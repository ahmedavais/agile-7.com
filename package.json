{
  "name": "agile-7.com",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "check": "astro check",
    "test": "vitest run",
    "verify": "npm run check && npm run lint && npm run spell && npm test && npm run build && npm run sense && npm run sense:browser",
    "deploy": "npm run build && wrangler deploy",
    "astro": "astro",
    "sense": "vitest run --config vitest.sensors.config.ts",
    "watch-production": "vitest run --config vitest.live.config.ts",
    "sense:browser": "playwright test",
    "spell": "cspell --no-progress --no-summary",
    "lint": "eslint ."
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "cspell": "^10.4.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  }
}
