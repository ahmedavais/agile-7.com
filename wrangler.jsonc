{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agile-7-com",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "routes": [
    { "pattern": "agile-7.com", "custom_domain": true },
    { "pattern": "www.agile-7.com", "custom_domain": true }
  ],
  "preview_urls": true
}
