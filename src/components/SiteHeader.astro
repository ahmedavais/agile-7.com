---
import Mark from '../assets/agile7-mark.svg';
import { navCurrent } from '../lib/nav-current';
import { publicPath } from '../lib/public-path';

const sections = [
  { path: '/work', name: 'work' },
  { path: '/about', name: 'about' },
  { path: '/writing', name: 'writing' },
];
const page = publicPath(Astro.url.pathname);
---

<header class="site-header">
  <a class="site-name" href="/">
    <Mark class="site-mark" aria-hidden="true" />
    agile-7
  </a>
  <nav class="site-nav" aria-label="Main">
    {sections.map((section) => <a href={section.path} aria-current={navCurrent(section.path, page)}>{section.name}</a>)}
  </nav>
</header>
