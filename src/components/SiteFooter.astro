---
interface Props {
  ask: boolean;
}

const { ask } = Astro.props;
---

<footer class="site-footer">
  {ask && (
    <section class="ask" aria-labelledby="ask-heading">
      <h2 id="ask-heading">Let's talk</h2>
      <p>If any of this sounds like your teams, I'd like to hear about it.</p>
      <a class="ask-button" href="/contact">let's talk →</a>
    </section>
  )}
  <nav class="elsewhere" aria-label="Elsewhere">
    <a href="https://www.linkedin.com/in/ahmedavais">LinkedIn</a>
    <a href="https://ahmedavais.com">ahmedavais.com</a>
    <span>© Agile 7, Inc.</span>
  </nav>
</footer>
