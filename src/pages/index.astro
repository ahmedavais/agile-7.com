---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SystemsJourney from '../components/SystemsJourney.astro';
import PublishedOn from '../components/PublishedOn.astro';
import { newestFirst } from '../lib/writing';

const [latestPost] = newestFirst(await getCollection('writing'));
---

<Base>
  <h1>I've spent 25 years learning how systems behave. First machines, then teams, and now teams working with AI.</h1>
  <p>I'm Ahmed Avais. I lead engineering teams, and before that I spent a decade coaching engineering and product leaders, at times across more than 200 teams. Agile-7 is where I help engineering leaders build healthy teams, make change stick, and work well with AI. <a href="/about">More about me</a>.</p>

  <SystemsJourney />

  {latestPost && (
    <section class="latest" aria-labelledby="latest-heading">
      <p class="label" id="latest-heading">latest writing</p>
      <a href={`/writing/${latestPost.id}`}>
        <h2>{latestPost.data.title}</h2>
      </a>
      <PublishedOn date={latestPost.data.date} />
      <p>{latestPost.data.summary}</p>
      <a class="more" href="/writing">all writing →</a>
    </section>
  )}
</Base>
