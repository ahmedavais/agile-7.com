---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SystemsJourney from '../components/SystemsJourney.astro';
import LatestEntry from '../components/LatestEntry.astro';
import { newestFirst } from '../lib/newest-first';

const [latestStory] = newestFirst(await getCollection('work'));
const [latestPost] = newestFirst(await getCollection('writing'));
---

<Base>
  <h1>For more than 25 years I've been learning how systems behave, from machines to teams to teams working with AI.</h1>
  <p>I'm Ahmed Avais, an engineering leader who spent a decade coaching engineering and product leaders, sometimes across more than 200 teams at once. Through Agile-7 I help engineering leaders build healthy teams, make change stick and lead well in complex systems, including the shift to AI happening now. <a href="/about">More about me</a>.</p>

  <SystemsJourney />

  {latestStory && (
    <LatestEntry
      label="latest work"
      href={`/work/${latestStory.id}`}
      title={latestStory.data.title}
      summary={latestStory.data.summary}
      allHref="/work"
      allLabel="all work →"
    />
  )}

  {latestPost && (
    <LatestEntry
      label="latest writing"
      href={`/writing/${latestPost.id}`}
      title={latestPost.data.title}
      summary={latestPost.data.summary}
      date={latestPost.data.date}
      allHref="/writing"
      allLabel="all writing →"
    />
  )}
</Base>
