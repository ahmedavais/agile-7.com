  { title: 'Adaptive Action for Sustainability', venue: 'ODN Summit, Raleigh', year: '2023' },
  { title: 'Sociocracy Training Workshop', venue: 'Common Ground EcoVillage', year: '2023' },
  { title: 'Using Human Systems Dynamics', venue: 'Ignite-Agility Meetup', year: '2021' },
  { title: 'Introduction to the Agile Fluency Suite', venue: 'Agile 757', year: '2021' },
  { title: 'Coaching clinic', venue: 'Big Apple Scrum Day', year: '2021' },
