  { title: 'Virtual Liberating Structures', venue: 'RTP Frontier', year: '2020', url: 'https://www.slideshare.net/slideshow/virtual-liberating-structures-rtp-frontier-may-2020/233687176' },
  { title: 'The Power of Inquiry', venue: 'Agile Open Northwest, Seattle', year: '2020', url: '/writing/the-power-of-inquiry' },
  { title: 'Sessions for agile coaches', venue: 'Dalian, China', year: '2019' },
  { title: 'Using the Harada Method to Develop People', venue: 'TriAgile, Raleigh', year: '2019', url: 'https://www.slideshare.net/slideshow/using-the-harada-method-to-develop-people/139352189' },
  { title: 'Custom-Tailored Agility', venue: 'Agile Leadership Network RTP', year: '2019', url: 'https://www.slideshare.net/slideshow/customtailored-agility-with-the-agile-fluency-model-137399132/137399132' },
  { title: 'Deliberate Practice: Myth, Magic, and Mindfulness', venue: 'Agile Cincy', year: '2018', url: 'https://www.slideshare.net/slideshow/deliberate-practice-myth-magic-and-mindfulness/93618888' },
