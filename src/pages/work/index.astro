---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { newestFirst } from '../../lib/newest-first';

const stories = newestFirst(await getCollection('work'));
---

<Base title="Work" description="Stories of change Ahmed Avais helped lead, told with the setbacks left in, because that's where most of the learning happened.">
  <h1>Work</h1>
  <p>These are stories from engagements I've led, told with the setbacks left in, because that's where most of the learning happened. Client names stay out, but the situations and outcomes are real.</p>
  <ol class="entry-list">
    {stories.map((story) => (
      <li>
        <a href={`/work/${story.id}`}>
          <h2>{story.data.title}</h2>
        </a>
        <p>{story.data.summary}</p>
      </li>
    ))}
  </ol>
</Base>
