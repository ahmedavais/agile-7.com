---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { shareCardPath } from '../../lib/share-card';

export async function getStaticPaths() {
  const stories = await getCollection('work');
  return stories.map((story) => ({ params: { slug: story.id }, props: { story } }));
}

interface Props {
  story: CollectionEntry<'work'>;
}

const { story } = Astro.props;
const { Content } = await render(story);
const shareImage = { path: shareCardPath('work', story.id), alt: `${story.data.title}, by Ahmed Avais on agile-7.com` };
---

<Base title={story.data.title} description={story.data.summary} shareImage={shareImage}>
  <article>
    <header class="post-header">
      <p class="label">work · {story.data.date.getUTCFullYear()}</p>
      <h1>{story.data.title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
